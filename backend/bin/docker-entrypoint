#!/bin/bash
set -e

# Remove a potentially pre-existing server.pid for Rails.
rm -f /rails/tmp/pids/server.pid

# Wait for database connection
echo "Waiting for PostgreSQL to be ready..."
until pg_isready -h "$DATABASE_HOST" -p "$DATABASE_PORT" -U "$DATABASE_USERNAME"; do
  sleep 1
done
echo "PostgreSQL is ready!"

# Setup and migrate database, then seed
echo "Setting up database..."
bundle exec rails db:prepare || bundle exec rails db:create db:migrate
echo "Seeding database with demo data..."
bundle exec rails db:seed

echo "Starting Rails API server..."
exec "$@"
